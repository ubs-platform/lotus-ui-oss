{
  "name": "postral-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/admin/postral-core/src",
  "prefix": "postral-core",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": {
          "base": "dist/apps/admin/postral-core",
          "browser": ""
        },
        "index": "apps/admin/postral-core/src/index.html",
        "browser": "apps/admin/postral-core/src/main.ts",
        "tsConfig": "apps/admin/postral-core/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/admin/postral-core/src/favicon.ico",
          "apps/admin/postral-core/src/sw.js",
          "apps/admin/postral-core/src/sw-dev.js",
          "apps/admin/postral-core/src/assets",
          "apps/admin/postral-core/src/manifest.webmanifest",
          {
            "glob": "**/*",
            "input": "common/localization",
            "output": "localization"
          }
        ],
        "styles": ["apps/admin/postral-core/src/styles.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/front-global/base-style/style"]
        },
        "serviceWorker": "apps/admin/postral-core/ngsw-config.json"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "3.1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "26kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "environment/environment.ts",
              "with": "environment/environment.prod.ts"
            }
          ],
          "outputHashing": "all",
          "optimization": true
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "postral-core:build:production"
        },
        "development": {
          "buildTarget": "postral-core:build:development",
          "port": 4204
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "apps/admin/postral-core/proxy.conf.json"
      },
      "continuous": true
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "postral-core:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/admin/postral-core"],
      "options": {
        "jestConfig": "apps/admin/postral-core/jest.config.ts"
      }
    }
  }
}
