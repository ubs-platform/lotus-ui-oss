FROM node:24-alpine AS deps
WORKDIR /app
# COPY package.json package-lock.json ./
COPY package.json ./
# TODO: NPM Registry'sinde bulunmayan paketler için mecbur koskoca node_modules klasörünü kopyalamak zorunda kaldım. Bu da build süresini uzatıyor, ama sonra bakarım...
# COPY node_modules ./node_modules
COPY decorate-angular-cli.js ./
RUN npm install --force --legacy-peer-deps --no-audit --no-fund
# COPY node_modules/@tk-postral ./node_modules/@tk-postral

FROM node:24-alpine AS build
WORKDIR /app
COPY . ./
COPY --from=deps /app/node_modules ./node_modules
RUN npx --yes nx run postral-core:build --baseHref / --skip-nx-cache
RUN npm prune --omit=dev --force --legacy-peer-deps && npm cache clean --force

