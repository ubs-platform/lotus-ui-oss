{
  "compileOnSave": false,
  "rules": {
    "@typescript-eslint/explicit-function-return-type": "error"
  },
  "compilerOptions": {
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2017", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@lotus-web/environment": ["environment/environment"],
      "@lotus/*": ["libs/*/src/index.ts"],
      "@ubs-platform/translator-core": [
        "libs/extra/translator-core/src/index.ts"
      ],
      "@ubs-platform/translator-ngx": [
        "libs/extra/ubs-translator-ngx/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
